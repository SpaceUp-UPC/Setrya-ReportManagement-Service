DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=report_management
# Set to true to connect to PostgreSQL over SSL (managed providers). Default: false
DB_SSL=false
PORT=3000
DATA_PROVIDER=mock
IOT_MONITORING_URL=http://localhost:3001
# Delimiter used when generating CSV reports (default: ";")
CSV_DELIMITER=;
