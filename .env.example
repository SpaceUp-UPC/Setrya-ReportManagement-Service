DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=report_management
# Set to true to connect to PostgreSQL over SSL (managed providers). Default: false
DB_SSL=false
PORT=3000
# --- Authentication (JWT issued by the IAM service) ---
# Secret shared with IAM. Required: the app refuses to start without it
# unless AUTH_DISABLED=true. Treated as raw text unless JWT_SECRET_BASE64=true.
JWT_SECRET=change-me
# Set to true if IAM's secret is Base64-encoded (it is decoded before use). Default: false
JWT_SECRET_BASE64=false
# WARNING: local development only. When true, requests are NOT authenticated and
# the requester comes from the request body. NEVER set to true in a deployment.
AUTH_DISABLED=false
# Comma-separated list of origins allowed by CORS ("*" allows any). Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200
DATA_PROVIDER=mock
IOT_MONITORING_URL=http://localhost:3001
# Delimiter used when generating CSV reports (default: ";")
CSV_DELIMITER=;
